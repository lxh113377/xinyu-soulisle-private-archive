<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.xinyu</groupId>
  <artifactId>soulisle-server</artifactId>
  <version>1.6.1</version>
  <name>soulisle-server</name>
  <description>心屿 SoulIsle — Java 全栈服务端（J1 骨架：静态页托管 + /api/health）</description>

  <properties>
    <java.version>17</java.version>
    <!-- 铁律：源码一律 UTF-8；Maven 侧等价物就是这两条 encoding 属性 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- J4 持久化：MyBatis-Plus（Boot 3 专用 starter）+ H2（演示默认）/ MySQL 8（生产可切） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.17</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- r41 补齐决策 #1 第②条（"强类型 + 可单测"）：此前 server/src 下 JUnit 用例数实测为 0，
         那句话从 2026-09-20 挂到 2026-09-27 没有产物支撑。用 starter 而非手挑 junit/assertj，
         与既有"优先用现成件"口径一致；test scope 不进 fat jar（repackage 排除 test 域）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>soulisle-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 词表 SSOT 默认按 ./src/ 解析，而 surefire 的 user.dir 默认是 server/
               ⇒ 不改这一条，构建期内所有加载词表的用例都会因路径不成立而红。
               指到仓库根等于把"启动工作目录必须是项目根"这条运行期铁律也在构建期钉住。 -->
          <workingDirectory>${project.basedir}/..</workingDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
