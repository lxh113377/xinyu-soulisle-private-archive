<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.xinyu</groupId>
  <artifactId>soulisle-server</artifactId>
  <version>1.6.1</version>
  <name>soulisle-server</name>
  <description>心屿 SoulIsle — Java 全栈服务端（J1 骨架：静态页托管 + /api/health）</description>

  <properties>
    <java.version>17</java.version>
    <!-- 铁律：源码一律 UTF-8；Maven 侧等价物就是这两条 encoding 属性 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- J4 持久化：MyBatis-Plus（Boot 3 专用 starter）+ H2（演示默认）/ MySQL 8（生产可切） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.17</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- r41 补齐决策 #1 第②条（"强类型 + 可单测"）：此前 server/src 下 JUnit 用例数实测为 0，
         那句话从 2026-09-20 挂到 2026-09-27 没有产物支撑。用 starter 而非手挑 junit/assertj，
         与既有"优先用现成件"口径一致；test scope 不进 fat jar（repackage 排除 test 域）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>soulisle-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 词表 SSOT 默认按 ./src/ 解析，而 surefire 的 user.dir 默认是 server/
               ⇒ 不改这一条，构建期内所有加载词表的用例都会因路径不成立而红。
               指到仓库根等于把"启动工作目录必须是项目根"这条运行期铁律也在构建期钉住。 -->
          <workingDirectory>${project.basedir}/..</workingDirectory>
        </configuration>
      </plugin>
      <!-- r75：覆盖率门（jacoco）。**阈值与余量见下方 <minimum> 旁的注释，随实测更新，禁手抄**。
           check 绑在 verify 相位 ⇒ CI 必须跑 `mvn verify`，否则这道门根本不会被执行
           （与 r41 的「CI 不得 -DskipTests」同族：门禁在不在链上，比门禁存在更关键）。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>jacoco-check-line-coverage</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <!-- 阈值沿革（每轮随实测更新，禁手抄上一轮）：
                           · 2026-09-28 r75 立门：实测 LINE 268/669 = 40.06%，下探一档取 0.35（余量 5.06 点）。
                           · 2026-09-29 r76 抬门：补齐四个 0% 类（EmotionController / MemoryController /
                             ChatController / MemoryService）+ HealthController + ApiTokenFilter 后，
                             实测 LINE **615/669 = 91.93%**，取 **0.85**（余量 6.93 点）。
                           为什么不取 0.90：91.93 距 0.90 只剩 1.93 点＝零余量地板，任何一处未覆盖的新代码
                           都会把构建判红，逼人抬阈值而不是补测试（r75 在册教训，同一把尺同一算法）。
                           抬阈值的前提「先补测试再改这一行」本轮成立：本轮就是先补的测试，
                           且 0.35 那一格从未被用来掩盖缺口（10 个 0% 类里 6 个本轮清零，剩 SoulIsleApplication 3 行）。
                           复算：`mvn -B -f server/pom.xml test` 后读 server/target/site/jacoco/jacoco.xml 的 LINE counter；
                           验牙：把上面 `<minimum>` 临时改成 0.99 跑 `mvn -B -ntp -f server/pom.xml test jacoco:check@jacoco-check-line-coverage`
                           ⇒ 必须 rc=1 且红因带实测比值（**改完务必按字节还原**）。
                           绑在 verify 相位 ⇒ CI 必须跑 `mvn verify`（java-build job 已从 package 改过来），
                           否则这道门根本不会被执行（与 r41「CI 不得 -DskipTests」同族）。 -->
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
