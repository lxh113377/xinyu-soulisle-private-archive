<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.xinyu</groupId>
  <artifactId>soulisle-server</artifactId>
  <version>1.6.1</version>
  <name>soulisle-server</name>
  <description>心屿 SoulIsle — Java 全栈服务端（J1 骨架：静态页托管 + /api/health）</description>

  <properties>
    <java.version>17</java.version>
    <!-- 铁律：源码一律 UTF-8；Maven 侧等价物就是这两条 encoding 属性 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- J4 持久化：MyBatis-Plus（Boot 3 专用 starter）+ H2（演示默认）/ MySQL 8（生产可切） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.17</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- r41 补齐决策 #1 第②条（"强类型 + 可单测"）：此前 server/src 下 JUnit 用例数实测为 0，
         那句话从 2026-09-20 挂到 2026-09-27 没有产物支撑。用 starter 而非手挑 junit/assertj，
         与既有"优先用现成件"口径一致；test scope 不进 fat jar（repackage 排除 test 域）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>soulisle-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 词表 SSOT 默认按 ./src/ 解析，而 surefire 的 user.dir 默认是 server/
               ⇒ 不改这一条，构建期内所有加载词表的用例都会因路径不成立而红。
               指到仓库根等于把"启动工作目录必须是项目根"这条运行期铁律也在构建期钉住。 -->
          <workingDirectory>${project.basedir}/..</workingDirectory>
        </configuration>
      </plugin>
      <!-- r75：覆盖率门（jacoco）。**阈值与余量见下方 <minimum> 旁的注释，随实测更新，禁手抄**。
           check 绑在 verify 相位 ⇒ CI 必须跑 `mvn verify`，否则这道门根本不会被执行
           （与 r41 的「CI 不得 -DskipTests」同族：门禁在不在链上，比门禁存在更关键）。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>jacoco-check-line-coverage</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <!-- 阈值沿革（每轮随实测更新，禁手抄上一轮）：
                           · 2026-09-28 r75 立门：实测 LINE 268/669 = 40.06%，下探一档取 0.35（余量 5.06 点）。
                           · 2026-09-29 r76 抬门：补齐四个 0% 类后 LINE 615/669 = 91.93%，取 0.85（余量 6.93 点）。
                             当时不取 0.90 的理由是"零余量地板会逼人抬阈值而不是补测试"——本轮补完测试后该理由消失。
                           · 2026-09-29 r77 换尺 + 抬门：r76 的门只量 LINE，而 LINE 91.93% 时**分支只有 83.11%**
                             ——行数覆盖会骗人（一行三元表达式只算 1 行，却有 2 个分支）。本轮补 LlmProxyTest
                             （JDK HttpServer 回环桩，零新依赖/零公网/零密钥）+ 词表加载器 seam + 五个控制器的
                             坏形态用例，实测 **LINE 651/666 = 97.75%**、**BRANCH 285/296 = 96.28%**
                             ⇒ LINE 取 **0.90**（余量 7.75 点）、新挂 BRANCH 取 **0.90**（余量 6.28 点）。
                           ⚠️ 分母本轮变过：删掉 ChatController 里实测零调用点的 2 参 bytes() 重载 ⇒ LINE 669→666。
                             这是**分母缩水**不是覆盖提升，两侧数字都在上面，复算时别把两者混成一句"涨到 97.75%"。
                           剩 11 支未覆盖分支的口径（逐条核过，不是"再补点测试"）：readTree 永不返回 null 的
                             `node == null` 3 支、buildPayload 结构上不可达的 `payload == null` 2 支、
                             ofString 永不返回 null 的 `body == null` 1 支、harden() 被上游守卫挡住的
                             `!messages.isArray()` 1 支、`||`/`&&` 短路后取不到的 2 支、删重载后永久不可达的
                             `safety != null` false 侧 1 支、MemoryController 三元组合 1 支 ⇒ 均为**不可达或短路边**，
                             不再为凑数写反射或假输入（那会把门禁变成自证）。
                           复算：`mvn -B -f server/pom.xml test` 后读 server/target/site/jacoco/jacoco.xml 里
                             `<report>` 自带的 `counter type=LINE|BRANCH` 两个属性（**分母取 counter 属性，
                             不得由逐类求和反推**——r77 就是这么产出一个假 drift 的）；
                           验牙：把下面任一 `<minimum>` 临时改成 0.99 跑
                             `mvn -B -ntp -f server/pom.xml test jacoco:check@jacoco-check-line-coverage`
                             ⇒ 必须 rc=1 且红因点名是哪一路 counter（**改完务必按字节还原**）。
                           绑在 verify 相位 ⇒ CI 必须跑 `mvn verify`（java-build job 已从 package 改过来），
                           否则这道门根本不会被执行（与 r41「CI 不得 -DskipTests」同族）。 -->
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
