# 心屿 SoulIsle — 环境变量样例（名称实读自 server/src/main/resources/application.yml、
# src/functions/api/chat.js、deploy/cloudbase/functions/chat/index.js）
# 复制为本地实际配置使用；本文件只放占位符，任何真实密钥禁止写入本文件或提交入库。

# ─────────────────────────────────────────────
# LLM 上游（Java 服务端 / Cloudflare Pages Function / CloudBase 云函数 共用同名变量）
# ─────────────────────────────────────────────
DEEPSEEK_KEY=your-api-key-here            # 必填。切勿提交真实值
DEEPSEEK_BASE=https://api.deepseek.com/v1 # OpenAI 兼容端点，可换任意兼容上游
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────────────────────────────
# Java 服务端（v2，server/，Spring Boot）
# ─────────────────────────────────────────────
XINYU_PORT=8080                           # 服务端口（本地演示常用 8123）
XINYU_WEB_ROOT=./src/                     # 前端静态页直读路径（零副本策略，工作目录须为仓库根）
XINYU_API_TOKEN=                          # 可选鉴权 token；留空 = 全放行（演示默认）
XINYU_EVAL_DATASET=./_test/emotion-eval-dataset.json  # 评测集直读路径（不复制进 jar）
XINYU_LEXICON=                            # 情绪词表 SSOT 文件路径；留空则用 XINYU_WEB_ROOT/data/emotion-lexicon.js

# 数据库（默认 H2 file，零配置可用；切 MySQL 时取消注释）
XINYU_DB_URL=jdbc:h2:file:./server/data/xinyu;MODE=MySQL;DB_CLOSE_DELAY=-1
# XINYU_DB_URL=jdbc:mysql://host:3306/xinyu?serverTimezone=Asia/Shanghai
# XINYU_DB_DRIVER=com.mysql.cj.jdbc.Driver
# XINYU_DB_USER=
# XINYU_DB_PASSWORD=

# ─────────────────────────────────────────────
# 本地前端演示配置（非环境变量）
# ─────────────────────────────────────────────
# src/js/demo-config.js 为本地演示预置（含 Key，已被 .gitignore 排除，禁入库/禁镜像）。
# 公网部署一律使用 deploy/xinyu/js/demo-config.js（零密钥同源代理版，按域名自适应）。
