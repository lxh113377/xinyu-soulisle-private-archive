# 心屿 MindIsle — 环境变量样例（名称实读自 server/src/main/resources/application.yml、
# src/functions/api/chat.js、deploy/cloudbase/functions/chat/index.js）
# 复制为本地实际配置使用；本文件只放占位符，任何真实密钥禁止写入本文件或提交入库。

# ─────────────────────────────────────────────
# LLM 上游（Java 服务端 / Cloudflare Pages Function / CloudBase 云函数 共用同名变量）
# ─────────────────────────────────────────────
# provider 适配层：LLM_* 是通用名（换任意 OpenAI 兼容上游只改这里，不改代码）；
# DEEPSEEK_* 保留为兼容别名，二者都给时 LLM_* 优先。两套都留空 = 回落 DeepSeek 默认端点/模型。
LLM_KEY=                                  # 通用名；未设则用 DEEPSEEK_KEY。切勿提交真实值
LLM_BASE=                                 # 通用名；未设则用 DEEPSEEK_BASE
LLM_MODEL=                                # 通用名；未设则用 DEEPSEEK_MODEL

DEEPSEEK_KEY=your-api-key-here            # 必填（或改用上方的 LLM_KEY）。切勿提交真实值
DEEPSEEK_BASE=https://api.deepseek.com/v1 # OpenAI 兼容端点，可换任意兼容上游
DEEPSEEK_MODEL=deepseek-chat

# ⚠️ 流式输出（SSE）能力按平台而异，无需配置：
#   · Cloudflare Pages Function（deploy/functions/api/chat.js）→ 支持，上游 SSE 直通
#   · Java 服务端（/api/chat）→ 支持
#   · CloudBase 云函数 → HTTP 访问服务是请求-响应模型，刻意不做流式；
#     前端检测到响应不是 text/event-stream 时自动回落整包渲染（设计内行为，非缺陷）

# ─────────────────────────────────────────────
# Java 服务端（v2，server/，Spring Boot）
# ─────────────────────────────────────────────
XINYU_PORT=8080                           # 服务端口（本地演示常用 8123）
XINYU_WEB_ROOT=./src/                     # 前端静态页直读路径（零副本策略，工作目录须为仓库根）
XINYU_API_TOKEN=                          # 可选鉴权 token；留空 = 全放行（演示默认）
XINYU_EVAL_DATASET=./_test/emotion-eval-dataset.json  # 评测集直读路径（不复制进 jar）
XINYU_LEXICON=                            # 情绪词表 SSOT 文件路径；留空则用 XINYU_WEB_ROOT/data/emotion-lexicon.js

# 数据库（默认 H2 file，零配置可用；切 MySQL 时取消注释）
XINYU_DB_URL=jdbc:h2:file:./server/data/xinyu;MODE=MySQL;DB_CLOSE_DELAY=-1
# 切 MySQL 8（下面四行整组取消注释）。URL 全参数逐条实测于 2026-10-12：
#   serverTimezone  —— 不写它时间列会按 JVM 默认时区解释，落库时刻随机器变；
#   characterEncoding —— 连接字符集显式 utf8mb4/utf8，不依赖服务端默认（下面那条要求同一件事）；
#   createDatabaseIfNotExist=true —— 目标库不存在时自动建，省掉「先手工 CREATE DATABASE」一步（实测：空服务器上直接起得来）；
#   connectTimeout=5000 —— 连不上时 5s 失败，而不是挂到 TCP 默认超时。
# 字符集（r169 起）：迁移脚本 V1__j4_baseline_schema.sql **自带**
#   ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci，列不再跟随服务器默认。
#   修前实测：latin1 服务器上同一份 DDL 建出的列是 latin1，写中文 ERROR 1366；修后 7 个字符列
#   全 utf8mb4，中文+emoji 逐字节往返相等。复算两条腿：
#     python _test/mysql_db_check.py --portability     # 反例腿（故意 latin1 服务器）
#     python _test/mysql_backup_drill.py               # 备份→删库→载回→HEX 对账
#   服务端仍是 utf8mb4 更好（排序规则、临时表、以及日后新增的裸建表都吃这个默认值），
#   但**不再是应用能跑起来的前提**。
# XINYU_DB_URL=jdbc:mysql://host:3306/xinyu?serverTimezone=Asia/Shanghai&characterEncoding=utf8&createDatabaseIfNotExist=true&connectTimeout=5000
# XINYU_DB_DRIVER=com.mysql.cj.jdbc.Driver
# XINYU_DB_USER=
# XINYU_DB_PASSWORD=

# 连接池（HikariCP）——r169 前这一节整面空白，全吃默认值（10 条连接、借不到等 30s、
# 无泄漏检测、连接不轮换）。库挂掉时每个请求挂 30s 才失败，与「不可达要快速回落」相反。
# 全部可覆盖；演示形态一行不改也能跑。
XINYU_DB_POOL_MAX=16                # 最大连接数：单实例演示够用；上线按「并发请求数×每请求连接数」核
XINYU_DB_POOL_MIN=2                 # 常驻空闲连接：留 2 条避免每次冷请求都新建（新建是毫秒级往返）
XINYU_DB_CONNECTION_TIMEOUT_MS=5000 # 借连接的等待预算 = 故障时用户最多被挂住多久
XINYU_DB_VALIDATION_TIMEOUT_MS=2500 # 取连接前的可用性校验预算（必须小于上面那个值，否则校验吃掉全部预算）
XINYU_DB_MAX_LIFETIME_MS=1740000    # 29min，刻意短于 MySQL wait_timeout 默认 8h：
                                    # 主动轮换才不会拿到被中间层（NAT/LB/代理）静默掐断的死连接
XINYU_DB_LEAK_DETECT_MS=20000       # 连接借出 20s 未还即打泄漏告警（配 0 = 关）

# DDL 演进通道（r169 引入 Flyway 版本化迁移；此前只有 CREATE TABLE IF NOT EXISTS，
# 那种形态只能建表不能改表，加一列对存量库永不生效）
XINYU_FLYWAY_ENABLED=true           # true = 启动时按 db/migration/V*.sql 前滚（默认）
XINYU_SQL_INIT_MODE=never           # 逃生门：置 always 可回到「每轮全量跑脚本」的旧行为
                                    # （两者同时开着会重复执行 DDL，切换时只留一个）

# ─────────────────────────────────────────────
# 本地前端演示配置（非环境变量）
# ─────────────────────────────────────────────
# src/js/demo-config.js 为本地演示预置（含 Key，已被 .gitignore 排除，禁入库/禁镜像）。
# 公网部署一律使用 deploy/xinyu/js/demo-config.js（零密钥同源代理版，按域名自适应）。
